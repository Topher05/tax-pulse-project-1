# Copy this file to `.env` and set your local PostgreSQL connection string.
# Do not commit `.env`; it stays local to each developer machine.

# Note: DB name MUST be taxpulse, docker host.docker.internal is required for docker run.
# The SCRUM-155 Compose stack overrides this inside containers with
# TAXPULSE_COMPOSE_POSTGRES_* values and Compose DNS.
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/taxpulse
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@host.docker.internal:5432/taxpulse

# Required local SCRUM-155 Docker Compose PostgreSQL settings. These are used only by
# docker-compose.yml to create the local Postgres container, run its healthcheck, and
# build the Core seed/Core service container-to-container DATABASE_URL over Compose DNS.
TAXPULSE_COMPOSE_POSTGRES_DB=taxpulse
TAXPULSE_COMPOSE_POSTGRES_USER=postgres
TAXPULSE_COMPOSE_POSTGRES_PASSWORD=replace-with-a-local-compose-password

# Optional placeholder Docker settings for `tests/typescript/dockerPostgres.ts`.
DOCKER_POSTGRES_IMAGE=postgres:18-alpine
DOCKER_POSTGRES_DB=taxpulse
DOCKER_POSTGRES_USER=postgres
DOCKER_POSTGRES_PASSWORD=postgres

# JWT issuer and verifier configuration. Only the Node issuer receives the RSA
# private key; the gateway and Tax Engine verify through the JWKS URL only.
JWT_ISSUER=https://auth.taxpulse.example
# The audience consumed by the shared HTTP API JWT authorizer.
JWT_AUDIENCE=taxpulse-http-api
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# The private key is issuer-only; do not provide it to the FastAPI Tax Engine or any other
# JWT verifier. Escaped newlines are supported.
JWT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-with-a-local-pkcs8-rsa-private-key\\n-----END PRIVATE KEY-----"
JWT_SIGNING_KEY_ID=local-rsa-key-2026-08
# Public-only JWK published by the temporary no-domain issuer metadata Lambda.
# It must match JWT_SIGNING_PRIVATE_KEY and include the same kid.
JWT_PUBLIC_JWK={"kty":"RSA","kid":"local-rsa-key-2026-08","n":"replace-with-public-modulus","e":"AQAB"}
# Optional: defaults to $JWT_ISSUER/.well-known/jwks.json.
JWT_JWKS_URL=https://auth.taxpulse.example/.well-known/jwks.json

# Tenant login hostnames. Use `localhost` for local development, for example
# `north-star-planning.localhost:3000`.
TAXPULSE_LOGIN_BASE_DOMAIN=localhost

# LocalStack/DynamoDB bootstrap for the Python queue projection flow.
# These are the only values the LocalStack bootstrap path needs from .env.
# For real AWS SNS/SQS checks, remove or blank these fake LocalStack credentials
# so the AWS SDK can use AWS_PROFILE or your approved temporary session credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
TAXPULSE_DYNAMODB_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_AUTH_TOKEN=replace-with-your-localstack-token

# AWS SNS & SQS references. Replace these with your stack's real values in .env.
TAXPULSE_STAGE_CHANGED_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:stage-changed
TAXPULSE_ACTION_ITEM_CREATED_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:action-item-created.fifo
# SNS/SQS stage-changed publisher and consumer for the TypeScript transition flow.
# LocalStack mode keeps the endpoint overrides below and uses fake test credentials.
# Real AWS mode requires a browser-authenticated AWS CLI profile before running the smoke:
#   aws login --profile taxpulse-login
# Follow the browser redirect, then set AWS_PROFILE to the profile name and replace the
# topic/queue values with the team's real AWS resources. For real AWS, leave the SNS/SQS
# endpoint override values empty so the AWS SDK uses AWS_REGION.
TAXPULSE_SNS_ENDPOINT_URL=http://localhost:4566
TAXPULSE_STAGE_CHANGED_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/taxpulse-stage-changed # SQS queue URL the consumer reads; in AWS use https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>.
TAXPULSE_SQS_ENDPOINT_URL=http://localhost:4566 # Optional SQS endpoint override for LocalStack/custom emulators; leave unset in real AWS so the SDK uses AWS_REGION.
TAXPULSE_PRESENT_TO_CLIENT_LAMBDA_ARN=arn:aws:lambda:us-east-1:000000000000:function:present-to-client
TAXPULSE_EXECUTE_LAMBDA_ARN=arn:aws:lambda:us-east-1:000000000000:function:execute
TAXPULSE_PRESENT_TO_CLIENT_API_URL=https://example.execute-api.us-east-1.amazonaws.com/dev/v1/tax-plan-cycles/{caseId}/present-to-client
TAXPULSE_EXECUTE_API_URL=https://example.execute-api.us-east-1.amazonaws.com/dev/v1/tax-plan-cycles/{caseId}/execute
# HTTP API JWT smoke configuration. Set these only in the approved issuer-admin
# environment, using a synthetic case that belongs to the synthetic tenant and user.
TAXPULSE_HTTP_API_URL=https://example.execute-api.us-east-1.amazonaws.com/Prod/
TAXPULSE_HTTP_API_SMOKE_CASE_ID=example-case-id
TAXPULSE_HTTP_API_SMOKE_TENANT_ID=example-tenant-id
TAXPULSE_HTTP_API_SMOKE_USER_ID=example-user-id

# Example real AWS smoke values, copied into `.env` only when testing SCRUM-156:
# AWS_PROFILE=taxpulse-login
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Redis queue cache for the TypeScript queue-read flow.
# The SCRUM-155 Compose stack overrides this inside Core with redis://taxpulse-redis:6379.
TAXPULSE_REDIS_URL=redis://localhost:6379

# Tax Engine base URL used by the Case service when modeling scenarios.
# The SCRUM-155 Compose stack overrides this inside Core with http://tax-engine:8000.
LIABILITY_ENGINE_BASE=http://localhost:8000

# Legacy TIVS SOAP service used by the Case service during Intake TIN/EIN validation.
TIVS_WSDL_URL=https://d2xnf2iv2yptek.cloudfront.net/tivs?wsdl
TIVS_ENDPOINT_URL=https://d2xnf2iv2yptek.cloudfront.net/tivs
TIVS_USERNAME=replace-with-tivs-username
TIVS_PASSWORD=replace-with-tivs-password

# Start the Core Case Service and UI in separate terminals:
# Optional Pulse UI override for the Core Case service.
# Leave unset for local Vite dev so `/v1` requests use the same-origin proxy.
# CASE_SERVICE_BASE_URL=http://localhost:3000

# Required for AI Assist Retrieval and Corpus tools
OPENAI_API_KEY=replace-with-your-openai-api-key
CORPUS_INPUT_DIR=data/corpus
CORPUS_INTAKE_CONFIG=data/corpus/corpus-intake.json
CORPUS_CHUNKS_PATH=data/corpus/build/chunks.jsonl
