{
  "name": "@taxpulse/pulse-ui",
  "version": "0.0.0",
  "description": "TaxPulse Pulse UI operator workspace",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.0.0"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "dev": "vite --config vite.config.ts",
    "test": "npm run test:vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:ax": "vitest run --config vitest.config.ts tests/accessibility/axeGate.test.tsx",
    "test:ax:deductions": "vitest run --config vitest.config.ts tests/deductions/mockDeductionsPage.test.tsx",
    "test:lighthouse": "node scripts/lighthouse-dashboard.mjs",
    "test:cov": "vitest run --config vitest.config.ts --coverage",
    "test:vitest": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.pulseUI.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.133.1",
    "@tanstack/react-table": "^9.0.0",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.83.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "24.1.3",
    "lighthouse": "^12.8.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "5.4.21",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
  }
}
