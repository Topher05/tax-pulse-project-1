{
  "family": "taxpulse-tax-engine",
  "taskRoleArn": "arn:aws:iam::814650854375:role/taxpulse-tax-engine-task-role",
  "executionRoleArn": "arn:aws:iam::814650854375:role/taxpulse-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "tax-engine",
      "image": "814650854375.dkr.ecr.us-east-1.amazonaws.com/taxpulse/tax-engine:v1.0.0.0",
      "essential": true,
      "portMappings": [
        {
          "name": "tax-engine-http",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8000"
        },
        {
          "name": "JWT_ISSUER",
          "value": "https://auth.taxpulse.example"
        }
      ],
      "secrets": [
        {
          "name": "JWT_SIGNING_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:814650854375:secret:TAX_PULSE_CONFIG-q9DNrQ:JWT_SIGNING_SECRET::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import os, sys, urllib.request; port = os.environ.get('PORT', '8000'); url = f'http://127.0.0.1:{port}/health'; sys.exit(0 if urllib.request.urlopen(url, timeout=2).status == 200 else 1)\""
        ],
        "interval": 10,
        "timeout": 3,
        "retries": 5,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "Tax-Engine",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
