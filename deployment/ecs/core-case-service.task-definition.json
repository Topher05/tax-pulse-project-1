{
  "family": "taxpulse-core-case-service",
  "taskRoleArn": "arn:aws:iam::814650854375:role/taxpulse-core-case-task-role",
  "executionRoleArn": "arn:aws:iam::814650854375:role/taxpulse-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "core-case-service",
      "image": "814650854375.dkr.ecr.us-east-1.amazonaws.com/taxpulse/core-case-service:v1.0.0.0",
      "essential": true,
      "portMappings": [
        {
          "name": "core-case-service-http",
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "JWT_ISSUER",
          "value": "https://auth.taxpulse.example"
        },
        {
          "name": "JWT_ACCESS_TOKEN_TTL_SECONDS",
          "value": "900"
        },
        {
          "name": "JWT_REFRESH_TOKEN_TTL_SECONDS",
          "value": "2592000"
        },
        {
          "name": "LIABILITY_ENGINE_BASE",
          "value": "http://tax-engine.taxpulse.local:8000"
        },
        {
          "name": "TAXPULSE_LOGIN_BASE_DOMAIN",
          "value": "taxpulse.example"
        },
        {
          "name": "TAXPULSE_REDIS_URL",
          "value": "redis://taxpulse-redis.taxpulse.local:6379"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "TAXPULSE_STAGE_CHANGED_TOPIC_ARN",
          "value": "arn:aws:sns:us-east-1:814650854375:stage-changed"
        },
        {
          "name": "TAXPULSE_STAGE_CHANGED_QUEUE_URL",
          "value": "https://sqs.us-east-1.amazonaws.com/814650854375/taxpulse-stage-changed"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:814650854375:secret:TAX_PULSE_CONFIG-q9DNrQ:DATABASE_URL::"
        },
        {
          "name": "JWT_SIGNING_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:814650854375:secret:TAX_PULSE_CONFIG-q9DNrQ:JWT_SIGNING_SECRET::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:' + (process.env.PORT || '3000') + '/health').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))\""
        ],
        "interval": 10,
        "timeout": 3,
        "retries": 5,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "Case-Service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
