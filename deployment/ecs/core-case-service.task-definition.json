{
  "family": "taxpulse-core-case-service",
  "taskRoleArn": "arn:aws:iam::814650854375:role/taxpulse-core-case-task-role",
  "executionRoleArn": "arn:aws:iam::814650854375:role/taxpulse-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "core-case-service",
      "image": "814650854375.dkr.ecr.us-east-1.amazonaws.com/taxpulse/core-case-service:2c85d3cd929ae2389553265760170f019afd1f84",
      "essential": true,
      "portMappings": [
        {
          "name": "core-case-service-http",
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "JWT_ISSUER",
          "value": "https://auth.taxpulse.example"
        },
        {
          "name": "JWT_ACCESS_TOKEN_TTL_SECONDS",
          "value": "900"
        },
        {
          "name": "JWT_REFRESH_TOKEN_TTL_SECONDS",
          "value": "2592000"
        },
        {
          "name": "LIABILITY_ENGINE_BASE",
          "value": "http://tax-engine.service.taxpulse.internal:8000"
        },
        {
          "name": "TAXPULSE_LOGIN_BASE_DOMAIN",
          "value": "taxpulse.example"
        },
        {
          "name": "TAXPULSE_REDIS_URL",
          "value": "redis://taxpulse-redis.cache.taxpulse.internal:6379"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "TAXPULSE_STAGE_CHANGED_TOPIC_ARN",
          "value": "arn:aws:sns:us-east-1:814650854375:stage-changed"
        },
        {
          "name": "TAXPULSE_STAGE_CHANGED_QUEUE_URL",
          "value": "https://sqs.us-east-1.amazonaws.com/814650854375/taxpulse-stage-changed"
        },
        {
          "name": "OTEL_SERVICE_NAME",
          "value": "core-case-service"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
          "value": "http://127.0.0.1:4318"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_PROTOCOL",
          "value": "http/protobuf"
        },
        {
          "name": "OTEL_PROPAGATORS",
          "value": "tracecontext,baggage,xray"
        },
        {
          "name": "OTEL_RESOURCE_ATTRIBUTES",
          "value": "deployment.environment=dev,service.namespace=taxpulse"
        },
        {
          "name": "OTEL_TRACES_SAMPLER",
          "value": "parentbased_traceidratio"
        },
        {
          "name": "OTEL_TRACES_SAMPLER_ARG",
          "value": "1"
        }
      ],
      "dependsOn": [
        {
          "containerName": "aws-otel-collector",
          "condition": "START"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "TERRAFORM_RUNTIME_CONFIG_SECRET_ARN:DATABASE_URL::"
        },
        {
          "name": "JWT_SIGNING_PRIVATE_KEY",
          "valueFrom": "TERRAFORM_RUNTIME_CONFIG_SECRET_ARN:JWT_SIGNING_PRIVATE_KEY::"
        },
        {
          "name": "JWT_SIGNING_KEY_ID",
          "valueFrom": "TERRAFORM_RUNTIME_CONFIG_SECRET_ARN:JWT_SIGNING_KEY_ID::"
        },
        {
          "name": "JWT_SIGNING_SECRET",
          "valueFrom": "TERRAFORM_RUNTIME_CONFIG_SECRET_ARN:JWT_SIGNING_SECRET::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:' + (process.env.PORT || '3000') + '/health').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))\""
        ],
        "interval": 10,
        "timeout": 3,
        "retries": 5,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "Case-Service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "aws-otel-collector",
      "image": "public.ecr.aws/aws-observability/aws-otel-collector:v0.30.0",
      "essential": true,
      "command": [
        "--config=/etc/ecs/ecs-default-config.yaml"
      ],
      "portMappings": [
        {
          "containerPort": 4317,
          "hostPort": 4317,
          "protocol": "tcp"
        },
        {
          "containerPort": 4318,
          "hostPort": 4318,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "Case-Service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "otel"
        }
      }
    }
  ]
}
