{
  "name": "tax-pulse-project-team-1",
  "version": "0.0.0",
  "description": "TaxPulse project workspace",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:check": "drizzle-kit check",
    "db:gen": "drizzle-kit generate",
    "db:monitor": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:force": "drizzle-kit push",
    "db:up": "drizzle-kit up",
    "dev": "tsx src/typescript/index.ts",
    "migrate": "tsx src/typescript/runMigrations.ts",
    "seed": "tsx src/typescript/db/seed.ts",
    "start": "node dist/typescript/index.js",
    "test": "npm run typecheck && npm run test:vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:migration": "vitest run tests/typescript/taxPlanCycleMigration.test.ts tests/typescript/userRoleMigration.test.ts",
    "test:migration:userRole": "vitest run tests/typescript/userRoleMigration.test.ts",
    "test:smoke": "node --import tsx --test tests/typescript/smoke.test.ts",
    "test:vitest": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "testcontainers": "^12.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "undici": "7.16.0"
  }
}
