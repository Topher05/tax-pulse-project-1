{
  "name": "tax-pulse-project-team-1",
  "version": "0.0.0",
  "description": "TaxPulse project workspace",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/typescript/index.ts",
    "start": "node dist/typescript/index.js",
    "test": "npm run typecheck && node --import tsx --test tests/typescript/smoke.test.ts && npm run test:vitest",
    "test:vitest": "vitest run tests/typescript/taxPlanCycle*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
