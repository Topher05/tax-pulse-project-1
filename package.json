{
  "name": "tax-pulse-project-team-1",
  "version": "0.0.0",
  "description": "TaxPulse project workspace",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config src/pulseUI/vite.config.ts",
    "db:check": "drizzle-kit check",
    "db:gen": "drizzle-kit generate",
    "db:monitor": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:force": "drizzle-kit push",
    "db:up": "drizzle-kit up",
    "dev": "tsx src/typescript/index.ts",
    "dev:web": "vite --config src/pulseUI/vite.config.ts",
    "migrate": "tsx src/typescript/runMigrations.ts",
    "seed": "tsx src/typescript/db/seed.ts",
    "start": "node dist/typescript/index.js",
    "test": "npm run typecheck && npm run test:vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:express": "vitest run --config src/typescript/vitest.config.ts",
    "test:migration": "vitest run --config src/typescript/vitest.config.ts tests/typescript/taxPlanCycleMigration.test.ts tests/typescript/tenantsMigration.test.ts tests/typescript/user/user.test.ts tests/typescript/user/userStatus.test.ts tests/typescript/role/role.test.ts tests/typescript/credential/credential.test.ts tests/typescript/mfa_enrollement/mfa_enrollement.test.ts tests/typescript/audit/auditEntry.test.ts tests/typescript/brackets/bracketReferenceMigration.test.ts tests/typescript/brackets/bracketReferenceRepository.test.ts",
    "test:migration:user": "vitest run --config src/typescript/vitest.config.ts tests/typescript/user/user.test.ts tests/typescript/user/userStatus.test.ts",
    "test:migration:role": "vitest run --config src/typescript/vitest.config.ts tests/typescript/role/role.test.ts",
    "test:pulseUI": "vitest run --config src/pulseUI/vitest.config.ts",
    "test:cov": "npm run test:cov:express && npm run test:cov:pulseUI",
    "test:cov:express": "vitest run --config src/typescript/vitest.config.ts --coverage",
    "test:cov:pulseUI": "vitest run --config src/pulseUI/vitest.config.ts --coverage",
    "test:smoke": "node --import tsx --test tests/typescript/smoke.test.ts",
    "test:vitest": "npm run test:express && npm run test:pulseUI",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p src/pulseUI/tsconfig.pulseUI.json --noEmit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "jsdom": "24.1.3",
    "testcontainers": "^12.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.133.1",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.553.0",
    "otplib": "^13.4.1",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "undici": "7.16.0"
  }
}
