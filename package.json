{
  "name": "tax-pulse-project-team-1",
  "version": "0.0.0",
  "description": "TaxPulse project workspace",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/typescript/index.ts",
    "migrate": "tsx src/typescript/runMigrations.ts",
    "start": "node dist/typescript/index.js",
    "test": "npm run typecheck && node --import tsx --test tests/typescript/smoke.test.ts && npm run test:vitest",

    "test:migration": "vitest run tests/typescript/taxPlanCycleMigration.test.ts",
    "test:vitest": "vitest run tests/typescript/taxPlanCycle.test.ts tests/typescript/taxPlanCycleTransitions.test.ts",

    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  }
}
